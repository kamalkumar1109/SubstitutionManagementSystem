# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sms

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Server
PORT=5050
NODE_ENV=development

# Optional: upserted on each server boot so Admin Login matches these values
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-now
SUPER_ADMIN_NAME=Platform Owner

# JWT expiry (optional)
JWT_EXPIRES_IN=7d

# Razorpay (use test/sandbox keys in development — never commit live secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to true only when expired schools should be blocked from substitution tools.
# Leave false during development so schools are not locked out.
SUBSCRIPTION_ENFORCEMENT=false
